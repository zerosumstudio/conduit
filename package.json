{
	"name": "@zerosumstudio/conduit",
	"version": "2.0.0",
	"description": "A data-fetching client for micro frontends",
	"keywords": [
		"micro-frontends",
		"module-federation",
		"fetch",
		"http-client",
		"cache",
		"request-queue",
		"deduplication",
		"abort",
		"typescript"
	],
	"homepage": "https://github.com/zerosumstudio/conduit#readme",
	"bugs": {
		"url": "https://github.com/zerosumstudio/conduit/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/zerosumstudio/conduit.git"
	},
	"license": "MIT",
	"author": "zerosum studio <hello@zerosum.studio>",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./react": {
			"import": {
				"types": "./dist/react.d.ts",
				"default": "./dist/react.js"
			},
			"require": {
				"types": "./dist/react.d.cts",
				"default": "./dist/react.cjs"
			}
		},
		"./devtools": {
			"import": {
				"types": "./dist/devtools.d.ts",
				"default": "./dist/devtools.js"
			},
			"require": {
				"types": "./dist/devtools.d.cts",
				"default": "./dist/devtools.cjs"
			}
		},
		"./testing": {
			"import": {
				"types": "./dist/testing.d.ts",
				"default": "./dist/testing.js"
			},
			"require": {
				"types": "./dist/testing.d.cts",
				"default": "./dist/testing.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"bench": "vitest bench --run",
		"build": "tsup",
		"check:api": "tsc -p tsconfig.public-api.json --noEmit",
		"dev": "tsup --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepublishOnly": "pnpm run verify",
		"size": "size-limit",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:run": "vitest run",
		"type-check": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit",
		"verify": "pnpm run type-check && pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run build && pnpm run check:api && pnpm run size"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@size-limit/preset-small-lib": "^13.0.3",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.8.1",
		"globals": "^17.9.0",
		"happy-dom": "^20.11.2",
		"prettier": "^3.9.6",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"size-limit": "^13.0.3",
		"terser": "^5.49.2",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"react": ">=18.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"packageManager": "pnpm@11.6.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"size-limit": [
		{
			"name": "Full bundle",
			"path": "dist/index.js",
			"limit": "12.5 KB"
		},
		{
			"name": "Core only",
			"path": "dist/index.js",
			"import": "{ createClient }",
			"limit": "6.5 KB"
		},
		{
			"name": "Core + common plugins",
			"path": "dist/index.js",
			"import": "{ createClient, sharedClient, cache, dedupe, retry, timeout, queue }",
			"limit": "10 KB"
		},
		{
			"name": "Errors only",
			"path": "dist/index.js",
			"import": "{ ConduitError, isConduitError }",
			"limit": "1 KB"
		},
		{
			"name": "React bindings",
			"path": "dist/react.js",
			"limit": "2.5 KB"
		},
		{
			"name": "Devtools",
			"path": "dist/devtools.js",
			"limit": "2 KB"
		},
		{
			"name": "Testing",
			"path": "dist/testing.js",
			"limit": "2 KB"
		}
	]
}
