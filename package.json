{
	"name": "@zerosumstudio/conduit",
	"version": "1.0.0",
	"description": "A data-fetching client for micro frontends",
	"keywords": [
		"micro-frontends",
		"module-federation",
		"fetch",
		"http-client",
		"cache",
		"request-queue",
		"deduplication",
		"abort",
		"typescript"
	],
	"homepage": "https://github.com/zerosumstudio/conduit#readme",
	"bugs": {
		"url": "https://github.com/zerosumstudio/conduit/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/zerosumstudio/conduit.git"
	},
	"license": "MIT",
	"author": "zerosum studio <hello@zerosum.studio>",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"default": "./dist/react.js"
		},
		"./devtools": {
			"types": "./dist/devtools.d.ts",
			"default": "./dist/devtools.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"default": "./dist/testing.js"
		},
		"./upload": {
			"types": "./dist/upload.d.ts",
			"default": "./dist/upload.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs/threat-model.md",
		"docs/migration-1.0.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepublishOnly": "pnpm run verify",
		"size": "size-limit",
		"smoke": "node scripts/smoke.mjs",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"type-check": "tsc --noEmit",
		"verify": "pnpm run type-check && pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run build && pnpm run size && pnpm run smoke"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@size-limit/preset-small-lib": "^14.3.0",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^5.1.1",
		"eslint": "^10.15.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.14.0",
		"jsdom": "^31.0.1",
		"prettier": "^3.10.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"size-limit": "^14.3.0",
		"tsdown": "^0.23.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vitest": "^5.1.1"
	},
	"peerDependencies": {
		"react": ">=18.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"packageManager": "pnpm@11.6.0",
	"engines": {
		"node": ">=26"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"size-limit": [
		{
			"name": "Main entry (everything)",
			"path": "dist/index.js",
			"limit": "13.5 KB"
		},
		{
			"name": "Core only",
			"path": "dist/index.js",
			"import": "{ createClient }",
			"limit": "7.4 KB"
		},
		{
			"name": "Core + common plugins",
			"path": "dist/index.js",
			"import": "{ createClient, sharedClient, cache, dedupe, retry, timeout, queue }",
			"limit": "10.9 KB"
		},
		{
			"name": "Errors only",
			"path": "dist/index.js",
			"import": "{ ConduitError, isConduitError }",
			"limit": "0.4 KB"
		},
		{
			"name": "React bindings",
			"path": "dist/react.js",
			"limit": "2.4 KB"
		},
		{
			"name": "Devtools",
			"path": "dist/devtools.js",
			"limit": "1.2 KB"
		},
		{
			"name": "Testing",
			"path": "dist/testing.js",
			"limit": "1.8 KB"
		},
		{
			"name": "Upload (progress)",
			"path": "dist/upload.js",
			"limit": "0.8 KB"
		}
	]
}
