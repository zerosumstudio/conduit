{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"types": ["react"],
		"skipLibCheck": false,
		"isolatedDeclarations": false,
		"declaration": false,
		"noUnusedLocals": false,
		"baseUrl": ".",
		"paths": {
			"@zerosumstudio/conduit": ["./dist/index.d.ts"],
			"@zerosumstudio/conduit/react": ["./dist/react.d.ts"],
			"@zerosumstudio/conduit/devtools": ["./dist/devtools.d.ts"],
			"@zerosumstudio/conduit/testing": ["./dist/testing.d.ts"]
		}
	},
	"include": ["test/public-api"]
}
